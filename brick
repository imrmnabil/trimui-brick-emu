#!/bin/bash
# TrimUI Brick emulator - main entry point.
#
#   ./brick setup [FW_TAG]         download + unpack stock firmware, build everything
#   ./brick sd OUT.img SIZE SRC... build an SD card image from CFW zips / folders
#   ./brick run [SD.img] [opts]    boot the emulated Brick (see scripts/run.sh)
#   ./brick manager                control window: start/stop, SD card files, tools
#   ./brick shell                  root shell on the running Brick (Ctrl-] detaches)
#   ./brick fetch nextui|spruce    download the latest custom firmware into cfw/
#   ./brick update                 rebuild emulator parts, keep internal storage
#   ./brick reset                  wipe internal storage back to factory state
#
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
S="$ROOT/scripts"
# disk tools live in /usr/sbin, which is not on a normal user's PATH on Debian
export PATH="$PATH:/usr/sbin:/sbin"

# user data (images, downloads): BRICK_DATA, default the source tree
DATA="${BRICK_DATA:-$ROOT}"; export BRICK_DATA="$DATA"
PY="${BRICK_PYTHON:-python3}"

fetch_firmware() {
  rm -rf "$DATA/firmware/stock" "$DATA/firmware/unpacked"
  "$PY" -I "$ROOT/tools/fetch.py" firmware ${1:+"$1"} "$DATA"
}

case "${1:-}" in
  setup)
    shift
    if [ -n "${BRICK_ASSETS:-}" ]; then
      # prebuilt emulator (installed package): only the stock firmware + internal storage
      [ -f "$DATA/firmware/unpacked/rootfs.fex" ] && [ $# -eq 0 ] || fetch_firmware "${1:-}"
      [ -f "$DATA/out/emmc.img" ] || "$S/make-emmc.sh"
      [ -z "${BRICK_VERSION:-}" ] || echo "$BRICK_VERSION" > "$DATA/out/.installed-version"
      echo "Ready."
      exit 0
    fi
    [ -f "$DATA/firmware/unpacked/rootfs.fex" ] && [ $# -eq 0 ] || fetch_firmware "${1:-}"
    docker image inspect brick-emu-builder >/dev/null 2>&1 || docker build -t brick-emu-builder "$ROOT/docker"
    # distro QEMU is preferred by run.sh; the bundled build is the fallback
    command -v qemu-system-aarch64 >/dev/null || [ -x "$DATA/out/qemu/bin/qemu-system-aarch64" ] || "$S/build-qemu.sh"
    "$S/build-kernel.sh"
    "$S/build-guest.sh"
    "$S/make-emmc.sh"
    echo; echo "Ready. Create an SD card, e.g.:"
    echo "  ./brick sd out/sdcard.img 16G path/to/NextUI-*-base.zip"
    echo "then: ./brick run"
    ;;
  sd)   shift; exec "$S/make-sdcard.sh" "$@" ;;
  shell) exec "$PY" -I "$ROOT/tools/shell.py" "$DATA/out/run/shell.sock" ;;
  fetch)
    case "${2:-}" in
      nextui|spruce) exec "$PY" -I "$ROOT/tools/fetch.py" cfw "$2" "$DATA" ;;
      firmware) fetch_firmware "${3:-}" ;;
      *) echo "usage: ./brick fetch nextui|spruce|firmware"; exit 1 ;;
    esac
    ;;
  update)
    [ -n "${BRICK_ASSETS:-}" ] || { "$S/build-kernel.sh"; "$S/build-guest.sh"; }
    "$S/make-emmc.sh" --update-rootfs ;;
  run)  shift; exec "$S/run.sh" "$@" ;;
  manager|gui) exec "$PY" -I "$ROOT/tools/brick-manager.py" ;;
  reset) exec "$S/make-emmc.sh" ;;
  *) sed -n 2,11p "$0" ;;
esac
