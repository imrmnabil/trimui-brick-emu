# AppImage builder: Ubuntu 22.04 (glibc 2.35 = the oldest host the AppImage
# runs on). Builds QEMU + virglrenderer and provides the Python/GTK runtime and
# disk tools that get bundled (see packaging/bundle.sh).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl wget xz-utils bzip2 file git patchelf desktop-file-utils \
      ninja-build meson pkg-config flex bison python3 python3-venv python3-pip \
      libglib2.0-dev libpixman-1-dev libslirp-dev libepoxy-dev libgbm-dev libdrm-dev libfdt-dev \
      zlib1g-dev libpulse-dev libasound2-dev libpng-dev libcap-ng-dev libx11-dev \
      python3-gi python3-gi-cairo python3-cairo gir1.2-gtk-3.0 libgtk-3-0 libgtk-3-bin \
      librsvg2-common gdk-pixbuf2.0-bin adwaita-icon-theme hicolor-icon-theme shared-mime-info \
      gdisk e2fsprogs dosfstools mtools p7zip-full \
    && rm -rf /var/lib/apt/lists/*
