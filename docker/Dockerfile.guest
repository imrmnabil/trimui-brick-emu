# Guest-side builder: Debian bullseye arm64 (glibc 2.31 <= Brick's glibc 2.33),
# provides Mesa 20.3 (llvmpipe + virgl) and a compiler for guest helpers.
FROM debian:bullseye
ENV DEBIAN_FRONTEND=noninteractive
# bullseye is EOL: use the archive
RUN printf 'deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/*
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc libc6-dev make file patchelf ca-certificates \
      libegl-dev libgles-dev libgbm-dev libdrm-dev libegl-mesa0 libgl1-mesa-dri libgles2 libgbm1 libsdl2-dev \
    && rm -rf /var/lib/apt/lists/*
