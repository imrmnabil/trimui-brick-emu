#!/bin/bash
# TrimUI Brick emulator AppImage entry point.
#   TrimUI_Brick_Emulator.AppImage                 the manager window
#   TrimUI_Brick_Emulator.AppImage run [opts]      boot directly (see ./brick)
#   TrimUI_Brick_Emulator.AppImage shell|sd|fetch|reset|update ...
# User data: $BRICK_DATA, default ~/.local/share/trimui-brick-emu
HERE="$(dirname "$(readlink -f "$0")")"
B="$HERE/opt/brick"
export BRICK_VERSION="@VERSION@"
export BRICK_ASSETS="$B/assets"
export BRICK_DATA="${BRICK_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/trimui-brick-emu}"
export BRICK_PYTHON="$HERE/usr/bin/python3"
export BRICK_QEMU="$HERE/usr/bin/qemu-system-aarch64"
export PATH="$HERE/usr/libexec/brick-tools:$PATH"
mkdir -p "$BRICK_DATA/out"

running() {  # an emulator is up on this data dir
  "$BRICK_PYTHON" -I -c 'import socket, sys
s = socket.socket(socket.AF_UNIX)
try: s.connect(sys.argv[1])
except OSError: sys.exit(1)' "$BRICK_DATA/out/run/mon.sock" 2>/dev/null
}
# after an AppImage update: refresh the internal storage's system partition
# (emulator hook), never while an emulator is using it
stamp="$BRICK_DATA/out/.appimage-version"
if [ -f "$BRICK_DATA/out/emmc.img" ] && [ "$(cat "$stamp" 2>/dev/null)" != "$BRICK_VERSION" ] && ! running; then
  echo "updating the emulated internal storage for version $BRICK_VERSION…" >&2
  "$B/scripts/make-emmc.sh" --update-rootfs >/dev/null && echo "$BRICK_VERSION" > "$stamp"
fi

case "${1:-}" in
  ""|manager|gui) exec "$BRICK_PYTHON" -I "$B/tools/brick-manager.py" ;;
  -v|--version) echo "TrimUI Brick emulator $BRICK_VERSION"; exit 0 ;;
  -h|--help|help)
    echo "TrimUI Brick emulator $BRICK_VERSION"
    echo "  $(basename "${APPIMAGE:-$0}")              open the manager"
    sed -n 's|^#   \./brick \(.*\)|  APP \1|p' "$B/brick" | grep -v ' setup ' | sed "s|APP|$(basename "${APPIMAGE:-$0}")|"
    exit 0 ;;
  *) exec "$B/brick" "$@" ;;
esac
